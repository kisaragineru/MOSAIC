# Runtime connection. MUST use the restricted `mosaic_app` role (RLS enforced, no BYPASSRLS).
DATABASE_URL=postgres://mosaic_app:CHANGE_ME@localhost:5432/mosaic_dev
# Migration/owner connection. Used only by `pnpm db:migrate` / `pnpm db:seed`, never by the web app.
MIGRATION_DATABASE_URL=postgres://mosaic_owner:CHANGE_ME@localhost:5432/mosaic_dev
# Public origin of the app (used for share URLs and Origin checks). No trailing slash.
APP_ORIGIN=http://localhost:3000
# Optional. When unset, all AI features fall back to deterministic, evidence-only output.
ANTHROPIC_API_KEY=
# Optional override of the Claude model used for AI text.
ANTHROPIC_MODEL=claude-opus-5-5
# Set to 1 only behind a proxy that overwrites X-Forwarded-For (enables per-IP rate limits).
TRUST_PROXY=0
# Random secret mixed into hashed rate-limit keys.
RATE_LIMIT_SALT=CHANGE_ME
# Optional, with TRUST_PROXY=1: take the client IP only from this platform header (Netlify: x-nf-client-connection-ip).
CLIENT_IP_HEADER=
# Optional: require this invite code at sign-up (public test deployments).
REGISTRATION_CODE=
